# The ROM itself — never commit it. Bring your own dump.
*.gen
*.bin
*.smd
# NOTE: do NOT ignore *.md — the repo's docs, issues and PROGRESS.md are
# markdown. (An earlier *.md rule silently ignored every doc file.)
# Toolchain / build outputs
.venv/
__pycache__/
*.pyc
build/
*.ips
!patches/**/*.ips
# Ghidra
*.gpr
*.rep/
# Emulator saves / states
*.srm
*.state*
# Ghidra install + projects (toolchain download, not repo content)
tools/ghidra/
# Generated disassembly (20 MB, reproducible — see disasm/README.md)
disasm/rop.s

# Fan-site research kept local-only (ripped audio, redundant large files)
docs/research/rings-of-power-ru/*.mp3
docs/research/rings-of-power-ru/*.gif
docs/research/rings-of-power-ru/*.rar
docs/research/rings-of-power-ru/map-thumb.jpg

# vasm built by tools/install_vasm.sh
tools/vasm/
tools/vasm-src/

# generated dialogue export (derived from ROM; not distributed, see docs/questions.md Q12)
assets/text/dialogue.txt
