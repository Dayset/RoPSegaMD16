 {
-   Gui._window=&Gui.kb()->first(GO_WINDOW)->asWindow();
+   // PATCH (RoP M7 #023, 2026-11-14): guard against null keyboard focus.
+   // The stock 2019 code dereferences Gui.kb() unconditionally, but Gui._kb
+   // is null when the first Desktop is constructed (GUI::create, before any
+   // keyboard focus exists), so the app segfaulted at startup in kbClear().
+   // With no focus there is no window to set; null is the GUI ctor's state.
+   if(GuiObj *kb=Gui.kb())Gui._window=&kb->first(GO_WINDOW)->asWindow();
+   else                   Gui._window=null;
 }
